{
  "name": "heal-community-manager",
  "version": "1.0.0",
  "description": "Multi-platform community management system for Heal (PC Web, Mobile Web, Android, iOS)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && node scripts/generate-route-meta.mjs",
    "preview": "vite preview",
    "seed:bung": "node scripts/seed-bung-records.mjs",
    "firebase:login": "npx firebase-tools login",
    "deploy:hosting": "npm run build && npx firebase-tools deploy --only hosting",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules",
    "deploy:all": "npm run build && npx firebase-tools deploy --only hosting,firestore:rules",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "firebase": "^10.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.4.0"
  }
}
