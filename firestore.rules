rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Members Collection
    match /members/{uid} {
      allow read, write: if true;
    }

    // 2. Meetings Collection: Public read & real-time sync across devices
    match /meetings/{meetingId} {
      allow read, write: if true;
    }

    // 3. Score Logs Collection
    match /scoreLogs/{logId} {
      allow read, write: if true;
    }

    // 4. Community Settings & Notice
    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
